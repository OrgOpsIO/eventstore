{
  "name": "@orgops/eventstore",
  "version": "0.1.1",
  "description": "A PostgreSQL realisation of the event-orientation and Command Context Consistency work of Ralf Westphal and Rico Fritzsche: one events table, scopes instead of aggregates, an atomic conditional append, indexes and locks derived from typed event declarations. Configure once, import `es` anywhere.",
  "type": "module",
  "license": "MIT",
  "author": "orgops",
  "keywords": [
    "event-sourcing",
    "event-store",
    "postgres",
    "ccc",
    "dcb",
    "zod",
    "typescript"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "require": {
        "types": "./dist/postgres/index.d.cts",
        "default": "./dist/postgres/index.cjs"
      }
    },
    "./subscribe": {
      "import": {
        "types": "./dist/subscribe/index.d.ts",
        "default": "./dist/subscribe/index.js"
      },
      "require": {
        "types": "./dist/subscribe/index.d.cts",
        "default": "./dist/subscribe/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "ES_TEST_DATABASE_URL=postgres://es:es@localhost:5432/es_sdk_test vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "pg": ">=8.11.0 <9",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrgOpsIO/eventstore.git"
  },
  "homepage": "https://github.com/OrgOpsIO/eventstore#readme",
  "bugs": {
    "url": "https://github.com/OrgOpsIO/eventstore/issues"
  }
}
